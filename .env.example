# Ortam değişkenleri şablonu — kopyalayıp `.env` yapın ve değerleri doldurun.
# Vite yalnızca VITE_ ile başlayan değişkenleri tarayıcıya aktarır.
# NOT: anon anahtar PUBLIC'tir (tarayıcıya açılması normaldir); service_role gibi
# GİZLİ anahtarlar ASLA buraya/istemciye konmaz — onlar Worker secret'ında durur.

# Boş bırakılırsa kod YEREL varsayılanlara düşer (http://127.0.0.1:54321 + yerel anon).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

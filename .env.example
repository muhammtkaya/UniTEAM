# Ortam değişkenleri şablonu — kopyalayıp `.env` yapın ve değerleri doldurun.
# Vite yalnızca VITE_ ile başlayan değişkenleri tarayıcıya aktarır.
# NOT: anon anahtar PUBLIC'tir (tarayıcıya açılması normaldir); service_role gibi
# GİZLİ anahtarlar ASLA buraya/istemciye konmaz — onlar Worker secret'ında durur.

# Boş bırakılırsa kod YEREL varsayılanlara düşer (http://127.0.0.1:54321 + yerel anon).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Gerçek zamanlı backend (Cloudflare Worker). Boşsa http://127.0.0.1:8787.
VITE_WORKER_URL=http://127.0.0.1:8787

# Gözlemlenebilirlik (Faz 7). DSN BOŞSA hiçbir ağ isteği yapılmaz; olaylar yalnız
# konsola/yerel tampona gider (hesap gerekmez). Buluta geçince (Faz 9) bir toplayıcı
# ucu (ör. kendi beacon toplayıcınız veya Sentry tünel ucu) konur.
VITE_OBSERVABILITY_DSN=
VITE_APP_ENV=local
VITE_OBS_SAMPLE_RATE=1

# ─── GELECEK HESAPLAR (uygulama büyüyünce / şirketlere satılınca) ───────────────
# Hepsi OPSİYONELdir; boş bırakılırsa ilgili entegrasyon "yapılandırılmamış"
# sayılır ve devre dışı kalır (davranış değişmez). Bu değerlerin HEPSİ PUBLIC
# tanımlayıcıdır (yayımlanabilir anahtar / OAuth client id). GİZLİ anahtarlar
# (Stripe secret key, Supabase service_role) ASLA buraya/istemciye konmaz —
# onlar Cloudflare Worker secret'ında (wrangler secret put) durur.
# Ayrıntı + hangi hesabın ne zaman açılacağı: docs/accounts.md

# Stripe — gerçek ödeme/abonelik (Faz 3 canlı). Yalnız yayımlanabilir anahtar:
VITE_STRIPE_PUBLISHABLE_KEY=
# Google Cloud — "Google ile giriş" + Drive BYOS (OAuth client id):
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Microsoft Entra/Azure — "Microsoft ile giriş" + OneDrive BYOS + kurumsal SAML/SCIM:
VITE_MS_OAUTH_CLIENT_ID=
